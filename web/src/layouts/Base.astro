---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Se oculta en la portada, donde no hay a dónde volver. */
  back?: boolean;
}

const { title, description, back = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>" />
  </head>
  <body>
    <button class="theme-btn" id="themeBtn" aria-label="Cambiar tema">◐</button>

    {back && (
      <div class="wrap topnav">
        <a href="/">← Todos los capítulos</a>
      </div>
    )}

    <slot />

    <footer>
      <div class="wrap stack">
        <span class="eyebrow">Sobre esto</span>
        <p style="color:var(--ink-2);font-size:.92rem">
          Trabajando <em>Hands-On Machine Learning</em> de Aurélien Géron, un capítulo
          por proyecto. Todo el código, los datos y los experimentos están en{" "}
          <a href="https://github.com/inter097/ml-handson">github.com/inter097/ml-handson</a>.
        </p>
      </div>
    </footer>

    <style>
      .theme-btn {
        position: fixed; top: 1rem; right: 1rem; z-index: 20;
        width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
        background: var(--surface); border: 1px solid var(--hairline); color: var(--ink-2);
        display: grid; place-items: center; font-size: .9rem; box-shadow: var(--shadow);
      }
      .topnav { padding-top: 1.6rem; }
      .topnav a {
        font-family: var(--mono); font-size: .74rem; letter-spacing: .04em;
        color: var(--muted); text-decoration: none;
      }
      .topnav a:hover { color: var(--accent-ink); text-decoration: underline; }
      footer { border-top: 1px solid var(--hairline); padding-block: 2.5rem 4rem; margin-top: 2rem; }
    </style>

    <script>
      const btn = document.getElementById("themeBtn")!;
      btn.addEventListener("click", () => {
        const actual = document.documentElement.getAttribute("data-theme");
        const oscuro = actual
          ? actual === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", oscuro ? "light" : "dark");
        // Las páginas con gráficas dibujadas en JS necesitan repintarlas:
        // los colores salen de variables CSS que acaban de cambiar.
        document.dispatchEvent(new CustomEvent("tema-cambiado"));
      });
    </script>
  </body>
</html>
