---
import "../styles/global.css";
import { CAPITULOS, tieneNavegacion } from "../data/capitulos";

interface Props {
  title: string;
  description: string;
  /** Se oculta en la portada, donde no hay a dónde volver. */
  back?: boolean;
  /** A dónde vuelve. Por defecto al índice; las subpáginas suben un nivel. */
  backHref?: string;
  backLabel?: string;
  /** Clave en CAPITULOS. Pinta la barra con las partes del capítulo. */
  capitulo?: string;
}

const {
  title,
  description,
  back = true,
  backHref = "/",
  backLabel = "Todos los capítulos",
  capitulo,
} = Astro.props;

// La barra se pinta igual en todas las partes del capítulo; lo único que
// cambia es cuál va marcada.
const partes = capitulo && tieneNavegacion(capitulo) ? CAPITULOS[capitulo] : [];
const aqui = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>" />
  </head>
  <body>
    <button class="theme-btn" id="themeBtn" aria-label="Cambiar tema">◐</button>

    {back && (
      <div class="wrap topnav">
        <a href={backHref}>← {backLabel}</a>
      </div>
    )}

    {partes.length > 0 && (
      <div class="wrap">
        <nav class="capnav" aria-label="Partes del capítulo">
          {partes.map((p) => (
            <a href={p.href} aria-current={p.href === aqui ? "page" : undefined}>
              <span class="cn-nombre">{p.nombre}</span>
              {p.pie && <span class="cn-pie">{p.pie}</span>}
            </a>
          ))}
        </nav>
      </div>
    )}

    <slot />

    <footer>
      <div class="wrap stack">
        <span class="eyebrow">Sobre esto</span>
        <p style="color:var(--ink-2);font-size:.92rem">
          Trabajando <em>Hands-On Machine Learning</em> de Aurélien Géron, un capítulo
          por proyecto. Todo el código, los datos y los experimentos están en{" "}
          <a href="https://github.com/inter097/ml-handson">github.com/inter097/ml-handson</a>.
        </p>
      </div>
    </footer>

    <style>
      .theme-btn {
        position: fixed; top: 1rem; right: 1rem; z-index: 20;
        width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
        background: var(--surface); border: 1px solid var(--hairline); color: var(--ink-2);
        display: grid; place-items: center; font-size: .9rem; box-shadow: var(--shadow);
      }
      .topnav { padding-top: 1.6rem; }
      .topnav a {
        font-family: var(--mono); font-size: .74rem; letter-spacing: .04em;
        color: var(--muted); text-decoration: none;
      }
      .topnav a:hover { color: var(--accent-ink); text-decoration: underline; }

      /* Barra de partes del capítulo. Se desliza en horizontal si no caben,
         en vez de apilarse: el orden de lectura es parte de la información. */
      .capnav {
        margin-top: .9rem; display: flex; gap: 1px; overflow-x: auto;
        background: var(--hairline); border: 1px solid var(--hairline);
        border-radius: 8px; scrollbar-width: none;
      }
      .capnav::-webkit-scrollbar { display: none; }
      .capnav a {
        flex: 1 0 auto; background: var(--surface); text-decoration: none;
        padding: .55rem .95rem; display: flex; flex-direction: column; gap: .1rem;
        color: var(--ink-2); transition: background .15s;
      }
      .capnav a:hover { background: var(--surface-2); }
      .capnav a[aria-current="page"] { background: var(--surface-2); box-shadow: inset 2px 0 0 var(--accent); }
      .cn-nombre { font-size: .88rem; white-space: nowrap; }
      .capnav a[aria-current="page"] .cn-nombre { color: var(--accent-ink); font-weight: 600; }
      .cn-pie {
        font-family: var(--mono); font-size: .6rem; letter-spacing: .1em;
        text-transform: uppercase; color: var(--muted); white-space: nowrap;
      }
      footer { border-top: 1px solid var(--hairline); padding-block: 2.5rem 4rem; margin-top: 2rem; }
    </style>

    <script>
      const btn = document.getElementById("themeBtn")!;
      btn.addEventListener("click", () => {
        const actual = document.documentElement.getAttribute("data-theme");
        const oscuro = actual
          ? actual === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", oscuro ? "light" : "dark");
        // Las páginas con gráficas dibujadas en JS necesitan repintarlas:
        // los colores salen de variables CSS que acaban de cambiar.
        document.dispatchEvent(new CustomEvent("tema-cambiado"));
      });
    </script>
  </body>
</html>
